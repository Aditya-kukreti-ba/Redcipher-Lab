# ─── RedCipher Labs — Oracle Cloud .env Template ─────────────────────────────
# Copy this as Backend/.env and fill in your values.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# ── HuggingFace ───────────────────────────────────────────────────────────────
HF_TOKEN=hf_YOUR_HUGGINGFACE_TOKEN_HERE
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# ── CORS — your Vercel frontend URL ──────────────────────────────────────────
FRONTEND_URL=https://redcipher-lab.vercel.app

# ── Database — stored in Docker volume ───────────────────────────────────────
DB_PATH=/app/data/redcipher.db

# ── Backend public URL — replace with your Oracle VM public IP ───────────────
# Example: http://129.154.xx.xx:4000
# If using Nginx on port 80: http://129.154.xx.xx
BACKEND_URL=http://YOUR_ORACLE_VM_PUBLIC_IP:4000
